<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_multicurrency_pos" model="ir.ui.view">
        <field name="name">product.template.form.multicurrency.pos</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='sales']" position="inside">
                <group string="Precio multimoneda en Punto de Venta">
                    <field name="pos_sale_currency_id" options="{'no_create': True}"/>
                    <field name="pos_foreign_price" invisible="not pos_use_foreign_currency"/>
                    <field name="pos_use_foreign_currency" invisible="1"/>
                    <field name="pos_company_price_preview" readonly="1" invisible="not pos_use_foreign_currency"/>
                    <div class="text-muted" colspan="2">
                        La moneda comercial solo controla el precio mostrado y congelado en el POS. La valoración del inventario y la contabilidad permanecen en la moneda de la compañía.
                    </div>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
