<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="pos_order_form_multicurrency" model="ir.ui.view">
    <field name="name">pos.order.form.multicurrency</field>
    <field name="model">pos.order</field>
    <field name="inherit_id" ref="point_of_sale.view_pos_pos_form"/>
    <field name="arch" type="xml">
      <xpath expr="//sheet" position="inside">
        <group string="Trazabilidad multimoneda">
          <group><field name="change_currency_id"/><field name="change_amount_currency"/></group>
          <group><field name="change_amount_company"/><field name="change_exchange_rate"/></group>
          <field name="payment_ids" colspan="2">
            <list create="0" delete="0" edit="0">
              <field name="payment_method_id"/><field name="payment_currency_id"/>
              <field name="amount_currency"/><field name="amount"/><field name="exchange_rate_snapshot"/>
            </list>
          </field>
          <field name="lines" colspan="2">
            <list create="0" delete="0" edit="0">
              <field name="product_id"/><field name="sale_currency_id"/><field name="foreign_unit_price"/>
              <field name="foreign_subtotal"/><field name="price_subtotal_incl"/><field name="exchange_rate_snapshot"/>
            </list>
          </field>
        </group>
      </xpath>
    </field>
  </record>
</odoo>
