<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="pos_config_form_multicurrency" model="ir.ui.view">
    <field name="name">pos.config.form.multicurrency</field>
    <field name="model">pos.config</field>
    <field name="inherit_id" ref="point_of_sale.pos_config_view_form"/>
    <field name="arch" type="xml">
      <xpath expr="//div[hasclass('o_settings_container')]" position="inside">
        <div class="col-12 col-lg-6 o_setting_box" id="pos_multicurrency_settings">
          <div class="o_setting_left_pane"><field name="enable_pos_multicurrency"/></div>
          <div class="o_setting_right_pane">
            <label for="enable_pos_multicurrency" string="POS multimoneda global"/>
            <div class="text-muted">Precios nativos, cobros mixtos, vuelto y arqueo por moneda.</div>
            <div class="content-group mt16" invisible="not enable_pos_multicurrency">
              <field name="allowed_currency_ids" widget="many2many_tags" options="{'no_create': True}"/>
              <field name="default_change_currency_id" options="{'no_create': True}"/>
              <field name="exchange_rate_source"/>
              <field name="currency_rate_ids" invisible="exchange_rate_source != 'manual'">
                <list editable="bottom">
                  <field name="currency_id" options="{'no_create': True}"/>
                  <field name="company_per_unit"/>
                </list>
              </field>
              <field name="show_native_product_prices"/>
              <field name="show_company_equivalent"/>
              <button name="action_install_cr_payment_methods" type="object" string="Crear/asignar métodos de pago Costa Rica" class="btn btn-primary mt16"/>
            </div>
          </div>
        </div>
      </xpath>
    </field>
  </record>
</odoo>
